# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/flipzone
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flipzone

# ── Auth ────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
